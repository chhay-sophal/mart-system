generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CASHIER
  INVENTORY
  ADMIN
}

enum Currency {
  USD
  KHR
}

enum StockMovementReason {
  SALE
  VOID
  RECEIVE_PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  STOCKTAKE
  ONLINE_ORDER
  ONLINE_ORDER_RELEASED
}

enum PaymentMethod {
  CASH
  KHQR
  CARD
}

enum OrderStatus {
  COMPLETED
  VOIDED
}

enum OnlineOrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  READY
  COLLECTED
  CANCELLED
  EXPIRED
}

enum OnlineOrderPaymentMethod {
  KHQR
  PAY_AT_COUNTER
}

enum OnlineOrderCancelReason {
  STAFF
  UNCOLLECTED
}

enum KhqrStatus {
  PENDING
  PAID
  EXPIRED
}

enum SyncEventType {
  SALE_COMPLETED
  SALE_VOIDED
}

enum SyncEventStatus {
  APPLIED
  DUPLICATE
  ERROR
}

enum StockTransferStatus {
  REQUESTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  timezone  String   @default("Asia/Phnom_Penh")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Weekly hours in the store's own timezone, shaped as shared-types'
  // OpeningHours ({ mon: { open: "07:00", close: "22:00" } | null, ... }).
  // Null means not set yet, which the storefront shows as "hours not listed".
  openingHours Json?
  latitude     Float?
  longitude    Float?

  userRoles        UserStoreRole[]
  terminals        Terminal[]
  storeProducts    StoreProduct[]
  stockMovements   StockMovement[]
  orders           Order[]
  onlineOrders     OnlineOrder[]
  settings         StoreSetting[]
  transfersFrom    StockTransfer[]   @relation("TransferFromStore")
  transfersTo      StockTransfer[]   @relation("TransferToStore")
  bakongCredential BakongCredential?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeRoles    UserStoreRole[]
  refreshTokens RefreshToken[]
  cashierOrders Order[]
}

model UserStoreRole {
  userId    String
  storeId   String
  role      UserRole
  pinHash   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Terminal {
  id                   String    @id @default(cuid())
  storeId              String
  name                 String
  deviceCredentialHash String
  pairedAt             DateTime  @default(now())
  lastSeenAt           DateTime?
  isActive             Boolean   @default(true)

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders         Order[]
  stockMovements StockMovement[]

  @@index([storeId])
}

model Product {
  id                String   @id @default(cuid())
  barcode           String?  @unique
  name              String
  category          String?
  defaultPriceMinor Int
  currency          Currency @default(USD)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  storeProducts    StoreProduct[]
  orderItems       OrderItem[]
  onlineOrderItems OnlineOrderItem[]
  stockMovements   StockMovement[]
}

model StoreProduct {
  id                 String   @id @default(cuid())
  storeId            String
  productId          String
  stock              Int      @default(0)
  priceOverrideMinor Int?
  costPriceMinor     Int      @default(0)
  currency           Currency @default(USD)
  lowStockThreshold  Int      @default(5)
  updatedAt          DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model StockMovement {
  id            String              @id @default(cuid())
  storeId       String
  productId     String
  terminalId    String?
  delta         Int
  reason        StockMovementReason
  refType       String?
  refId         String?
  sourceEventId String?
  createdAt     DateTime            @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  terminal Terminal? @relation(fields: [terminalId], references: [id])

  @@index([storeId, productId])
  @@index([createdAt])
  @@index([sourceEventId])
}

model Order {
  id                  String        @id @default(cuid())
  storeId             String
  terminalId          String
  clientOrderUuid     String        @unique
  customerId          String?
  cashierUserId       String?
  totalAmountMinor    Int
  currency            Currency
  paymentMethod       PaymentMethod
  bankName            String?
  amountPaidUsdMinor  Int           @default(0)
  amountPaidKhrMinor  Int           @default(0)
  changeGivenKhrMinor Int           @default(0)
  status              OrderStatus   @default(COMPLETED)
  isDeleted           Boolean       @default(false)
  createdAt           DateTime
  syncedAt            DateTime?

  store               Store                @relation(fields: [storeId], references: [id])
  terminal            Terminal             @relation(fields: [terminalId], references: [id])
  cashier             User?                @relation(fields: [cashierUserId], references: [id])
  items               OrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([storeId, createdAt])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  quantity         Int
  priceAtSaleMinor Int
  currency         Currency

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// Deliberately its own model, not fields on Store — a cached bearer token must
// never ride along on the generic GET /api/stores responses any staff role can
// already read.
model BakongCredential {
  storeId           String    @id
  registeredEmail   String?
  apiToken          String?
  apiTokenUpdatedAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Exactly one of orderId (a till sale's KHQR payment) or onlineOrderId (a
// storefront order's) is set.
model PaymentTransaction {
  id            String     @id @default(cuid())
  orderId       String?
  onlineOrderId String?
  md5Hash       String     @unique
  qrString      String
  bankName      String?
  currency      Currency
  amountMinor   Int
  status        KhqrStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  onlineOrder OnlineOrder? @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)

  @@index([onlineOrderId])
}

// A storefront order for in-store pickup. See docs/online-orders-plan.md.
// Deliberately not an Order (a till sale, which needs a terminal); reports
// read collected OnlineOrders alongside Orders instead.
model OnlineOrder {
  id                     String                   @id @default(cuid())
  storeId                String
  // The shopper's only handle on the order (/orders/:publicToken) — random, never the id.
  publicToken            String                   @unique
  // Browser-generated per checkout attempt, so a double submit returns the same order.
  clientOrderUuid        String                   @unique
  pickupCode             String
  status                 OnlineOrderStatus
  paymentMethod          OnlineOrderPaymentMethod
  // What was actually taken at the counter for a PAY_AT_COUNTER order.
  collectedPaymentMethod PaymentMethod?
  customerName           String
  customerPhone          String
  note                   String?
  // Null = "as soon as it's ready".
  pickupAt               DateTime?
  // PAY_AT_COUNTER only: auto-cancelled (UNCOLLECTED) if still open after this.
  holdUntil              DateTime?
  // KHQR only: the QR code (and the stock held for it) expires at this time.
  paymentExpiresAt       DateTime?
  // Throttles Bakong status checks across many polling tabs.
  lastPaymentCheckAt     DateTime?
  // Always USD, like Order — KHR-priced lines converted at exchangeRate (the store's setting at order time).
  totalAmountMinor       Int
  currency               Currency                 @default(USD)
  exchangeRate           Float
  cancelReason           OnlineOrderCancelReason?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  paidAt                 DateTime?
  readyAt                DateTime?
  collectedAt            DateTime?
  cancelledAt            DateTime?

  store               Store                @relation(fields: [storeId], references: [id])
  items               OnlineOrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([storeId, status])
  @@index([storeId, collectedAt])
  @@index([status, holdUntil])
  @@index([status, paymentExpiresAt])
}

model OnlineOrderItem {
  id                String   @id @default(cuid())
  onlineOrderId     String
  productId         String
  // Kept so the order still reads right if the product is renamed or deleted later.
  nameAtOrder       String
  quantity          Int
  priceAtOrderMinor Int
  currency          Currency

  onlineOrder OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([onlineOrderId])
}

model SyncEvent {
  id            String          @id @default(cuid())
  eventId       String          @unique
  terminalId    String
  storeId       String
  eventType     SyncEventType
  sequenceNo    Int
  payload       Json
  status        SyncEventStatus
  appliedAt     DateTime?
  resultOrderId String?
  errorMessage  String?
  createdAt     DateTime        @default(now())

  @@index([terminalId, sequenceNo])
  @@index([storeId])
}

model SyncCursor {
  terminalId     String   @id
  lastAppliedSeq Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model StoreSetting {
  storeId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, key])
}

model StockTransfer {
  id          String              @id @default(cuid())
  fromStoreId String
  toStoreId   String
  status      StockTransferStatus @default(REQUESTED)
  requestedBy String
  createdAt   DateTime            @default(now())
  completedAt DateTime?

  fromStore Store               @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore   Store               @relation("TransferToStore", fields: [toStoreId], references: [id])
  items     StockTransferItem[]
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}
