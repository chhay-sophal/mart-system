DATABASE_URL=file:./dev.db
# Required once DATABASE_URL points at a real Turso database (libsql://<db>.turso.io);
# unused for a local file: URL.
TURSO_AUTH_TOKEN=
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CASHIER_SESSION_TTL=14h
PASSWORD_BCRYPT_COST=12
PIN_BCRYPT_COST=10
PORT=4000
NODE_ENV=development
# Required in production (NODE_ENV=production) — comma-separated origins
# allowed to call this API from a browser, e.g. https://ims.example.com
CORS_ALLOWED_ORIGINS=
