# Local dev needs no account: DATABASE_URL=file:./dev.db
# For a real Turso database instead, use:
#   DATABASE_URL=libsql://REPLACE_WITH_YOUR_DB_NAME.turso.io
#   TURSO_AUTH_TOKEN=REPLACE_WITH_YOUR_TURSO_AUTH_TOKEN
DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CASHIER_SESSION_TTL=14h
PASSWORD_BCRYPT_COST=12
PIN_BCRYPT_COST=10
PORT=4000
NODE_ENV=development
# Required in production (NODE_ENV=production) — comma-separated origins
# allowed to call this API from a browser, e.g. https://ims.example.com
CORS_ALLOWED_ORIGINS=
