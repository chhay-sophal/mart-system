# Mart System POS — sidecar environment configuration
# In a packaged Tauri build the sidecar always binds an OS-assigned ephemeral
# port (the Rust shell discovers it by reading "PORT:<n>" off stdout) — that
# path never spawns in `tauri dev` (debug builds skip the sidecar-spawn logic
# entirely), so PORT is fixed at 5050 here to match the frontend's dev-mode
# fallback URL (see apps/pos/src/BackendContext.jsx).
PORT=5050

# Where the local SQLite file (and, from Phase 6, backups) live.
# Defaults to ~/.mart-system-pos if unset.
# POS_DATA_DIR=
