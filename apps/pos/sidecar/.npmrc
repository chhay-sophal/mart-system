# @yao-pkg/pkg reads its `assets` glob (sql.js's wasm file) by walking node_modules
# as real files. pnpm's default node-linker symlinks packages from a central
# content-addressable store, which pkg does not follow — it reports the wasm
# asset as missing even though it's declared in package.json#pkg.assets.
# Forcing a flat/hoisted node_modules here (like classic npm) fixes it, scoped
# to just this sidecar so the rest of the monorepo keeps pnpm's normal layout.
node-linker=hoisted
